generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model recado {
  id           Int      @id @default(autoincrement())
  texto        String   @db.VarChar(255)
  deId         Int
  de           pessoa   @relation("recadoDe", fields: [deId], references: [id], onDelete: Cascade)
  paraId       Int
  para         pessoa   @relation("recadoPara", fields: [paraId], references: [id], onDelete: Cascade)
  lido         Boolean  @default(false)
  data         DateTime @default(now()) @db.Timestamp(0)
  criadoEm     DateTime @default(now()) @db.DateTime(6)
  atualizadoEm DateTime @default(now()) @db.DateTime(6)
}


model pessoa {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  email        String   @db.VarChar(100)
  senha        String   @db.VarChar(6)
  criadoEm     DateTime @default(now()) @db.DateTime(6)
  atualizadoEm DateTime @default(now()) @db.DateTime(6)
  recadosDe    recado[] @relation("recadoDe")
  recadosPara  recado[] @relation("recadoPara")
}


model empresa {
  id           Int      @id @default(autoincrement())
  nomeEmpresa  String   @db.VarChar(100)
  cnpj         String   @db.VarChar(18)
  criadoEm     DateTime @default(now()) @db.DateTime(6)
  atualizadoEm DateTime @default(now()) @db.DateTime(6)
}
